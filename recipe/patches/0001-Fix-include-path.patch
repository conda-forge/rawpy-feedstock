From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jeongseok Lee <jeongseok@meta.com>
Date: Sat, 9 May 2026 14:42:00 -0700
Subject: [PATCH] Use conda LibRaw paths on Windows

---
 setup.py | 31 +++++++++++++++++++++++++++++--
 1 file changed, 29 insertions(+), 2 deletions(-)

diff --git a/setup.py b/setup.py
index 2dcab62..5cd7fd6 100644
--- a/setup.py
+++ b/setup.py
@@ -84,6 +84,31 @@
     _ask_pkg_config(libraries, "--libs-only-l", "-l")
 
 
+def use_conda_libraw():
+    prefix = os.environ.get("PREFIX")
+    if not prefix:
+        raise RuntimeError(
+            "Environment variable PREFIX is not defined; this package must be "
+            "built in a conda environment."
+        )
+
+    if isWindows:
+        prefix = os.path.join(prefix, "Library")
+
+    include_dirs.extend(
+        [
+            os.path.join(prefix, "include"),
+            os.path.join(prefix, "include", "libraw"),
+        ]
+    )
+    library_dirs.append(os.path.join(prefix, "lib"))
+    libraries[:] = ["raw_r"]
+
+
+def has_libraw_config_header(include_dir):
+    return os.path.isdir(include_dir) and "libraw_config.h" in os.listdir(include_dir)
+
+
 def clone_submodules():
     if not os.path.exists("external/LibRaw/libraw/libraw.h"):
         print(
@@ -310,9 +335,12 @@
     libraw_config_found = True
 else:
     # Use system library
-    use_pkg_config()
+    if isWindows:
+        use_conda_libraw()
+    else:
+        use_pkg_config()
     for include_dir in include_dirs:
-        if "libraw_config.h" in os.listdir(include_dir):
+        if has_libraw_config_header(include_dir):
             libraw_config_found = True
             break
 
